{
  "name": "@justmytwospence/anthropic-billing-guard",
  "version": "0.1.0",
  "description": "Warn the moment Anthropic bills a pi or opencode request to extra usage instead of the Claude plan.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "anthropic",
    "billing",
    "opencode"
  ],
  "pi": {
    "extensions": [
      "./integrations/pi/anthropic-billing-guard.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.1",
    "@earendil-works/pi-tui": ">=0.87.1",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justmytwospence/anthropic-billing-guard"
  }
}
